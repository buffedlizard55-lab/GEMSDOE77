     return all(abs(float(x) - float(y)) < tolerance for x, y in zip(a[:6], b[:6]))
 
 
+def footprint_from_reference(reference_path: str | Path) -> np.ndarray:
+    """OFFICIAL footprint = finite cells of sample_submission.tif (== labels.tif != -1).
+
+    Measured: 5,167,373 cells.  Feature band 1 is valid on 5,165,852 cells and disagrees on
+    3,061 + 1,540 cells, so it must not define the scored region.
+    """
+    import rasterio
+
+    with rasterio.open(reference_path) as src:
+        a = src.read(1)
+        nodata = src.nodata
+    if np.issubdtype(a.dtype, np.floating):
+        return np.isfinite(a) if nodata is None or np.isnan(nodata) else np.isfinite(a) & (a != nodata)
+    return a != (nodata if nodata is not None else -1)
+
+
 def footprint_from_features(features_path: str | Path, shape_hw=None) -> np.ndarray:
     """Footprint = cells whose first feature band is finite and above the nodata sentinel."""
